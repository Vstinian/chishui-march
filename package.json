{
  "name": "chishui-march",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "smoke": "node tests/smoke.mjs && node tests/audio.mjs && node tests/opening-audio.mjs && node tests/audio-library.mjs",
    "studio": "vite --host 127.0.0.1 --port 5175 --open /audio-studio.html",
    "audio:prepare": "node tools/prepare-audio.mjs",
    "audio:voices": "node tools/prepare-voices.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
